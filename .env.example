# Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=3001
LOG_LEVEL=info

# PostgreSQL (development placeholder only; replace locally, never commit real credentials)
DATABASE_URL=postgresql://campus_skill_exchange:change-me@localhost:5432/campus_skill_exchange?schema=public

# Browser-safe API path. Keep this as a same-origin path in local development.
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Server-only API origin used by the Next.js rewrite. Do not expose provider secrets here.
API_INTERNAL_URL=http://localhost:3001

# Credentialed CORS origins, comma-separated. Do not use * with credentials.
CORS_ORIGINS=http://localhost:3000

# Authentication/session foundation
AUTH_SESSION_TTL_SECONDS=2592000
AUTH_SESSION_COOKIE_NAME=cse_session
AUTH_SESSION_SAME_SITE=lax

# OIDC values are reserved for a later provider adapter. No external provider is connected in Prompt 1.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Google Calendar / Meet integration (server-only; never expose tokens to the browser)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/v1/integrations/google/callback

# Razorpay (server-only; use TEST mode credentials during development)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
